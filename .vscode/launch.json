{
    // F5: launches `mpremote debug unix` and attaches VS Code's Python
    // debugger to the on-target debugpy server. No host/port to type - the
    // MicroPython extension (extension/) reads them off the command's
    // MPDBG-READY handshake line.
    //
    // The `debug` command is not in a released mpremote, so this drives the
    // submodule's copy through `python3 -m mpremote`. `env` supplies what
    // `mpremote debug unix` needs and this repo has no mpdebug.toml for: the
    // debug-enabled firmware (built by `make firmware-unix`) and where the
    // debugpy module lives - the same two the Makefile's `demo` target sets.
    "version": "0.2.0",
    "configurations": [
        {
            "type": "micropython",
            "request": "launch",
            "name": "MicroPython: Debug",
            "target": "unix",
            "program": "target:main",
            "cwd": "${workspaceFolder}",
            "mpremotePath": "python3",
            "mpremoteArgs": ["-m", "mpremote"],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/micropython/tools/mpremote",
                "MPY_DEBUG_FIRMWARE": "${workspaceFolder}/micropython/ports/unix/build-standard/micropython",
                "MICROPYPATH": "${workspaceFolder}/src:${workspaceFolder}/micropython-lib/python-ecosys/debugpy"
            }
        }
    ]
}
