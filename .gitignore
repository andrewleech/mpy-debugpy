# Firmware binaries are not stored in-repo; they are described by
# firmware/firmware.toml and fetched/built on demand (see launcher/firmware.py).
firmware/**/*.bin
firmware/**/*.elf
firmware/**/*.uf2
firmware/**/*.dfu
firmware/**/micropython
firmware/build*/

# debugpy cross-compiled artifacts
launcher/compiled/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Local secrets (device WiFi credentials)
src/_secrets.py

# Per-developer mpremote debug targets (STORY-7.2); this repo's own default
# path has none. A host test writes one transiently and removes it, so this
# also guards against a leftover from a killed test run.
/mpdebug.toml

# Editor/OS
.DS_Store

.vscode-test/
